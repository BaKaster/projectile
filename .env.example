POSTGRES_DB=projectile
POSTGRES_USER=projectile
POSTGRES_PASSWORD=replace-with-a-long-random-password

POSTGRES_PORT=55432
PROJECTILE_DATABASE_URL=postgresql+asyncpg://projectile:replace-with-a-long-random-password@db:5432/projectile
PROJECTILE_STORAGE_ROOT=/app/storage
PROJECTILE_PROJECT_TYPES_PATH=/app/data/project-types.json
PROJECTILE_PROJECT_STAGE_TEMPLATES_PATH=/app/data/project-stage-templates.json
PROJECTILE_PROJECT_WORK_TEMPLATES_PATH=/app/data/project-work-templates.json
PROJECTILE_MAX_UPLOAD_SIZE_BYTES=536870912
PROJECTILE_MAX_FILES_PER_REQUEST=1000
PROJECTILE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PROJECTILE_AUTO_CREATE_SCHEMA=true

# Codex CLI can use an API key in deployments where auth.json cannot be mounted.
# Leave empty to keep using the authenticated auth.json session below.
KEY_OPENAI=

# Windows example: C:/Users/username/.codex
PROJECTILE_CODEX_HOME=
PROJECTILE_CODEX_CLI=codex
PROJECTILE_CODEX_TIMEOUT_SECONDS=300
PROJECTILE_ANALYSIS_MODEL=gpt-5.5
PROJECTILE_ANALYSIS_DIGEST_CONCURRENCY=2

# Faster CPU default. large-v3 is more accurate but substantially slower.
PROJECTILE_RECOGNITION_MODEL=small
PROJECTILE_RECOGNITION_DEVICE=cpu
PROJECTILE_RECOGNITION_COMPUTE_TYPE=int8
PROJECTILE_ANALYSIS_WORKER_ENABLED=true
